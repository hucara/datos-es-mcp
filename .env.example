# Server configuration
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_ENV=local
LOG_LEVEL=INFO

# AEMET API key (required for weather tools)
# Get a free key at: https://opendata.aemet.es/
AEMET_API_KEY=

# Optional: Sentry error tracking
SENTRY_DSN=
SENTRY_SAMPLE_RATE=1.0

# Optional: Matomo analytics
MATOMO_URL=
MATOMO_SITE_ID=
MATOMO_AUTH_TOKEN=
